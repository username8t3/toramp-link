{
  "name": "toramp-link",
  "version": "0.5.0-beta.1",
  "private": true,
  "description": "Toramp for Lampa: direct session and watched episode sync",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "rollup -c",
    "test": "node --import tsx --test tests/*.test.ts",
