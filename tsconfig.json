{
  "compilerOptions": {
    "target": "ES2017", "module": "ESNext", "moduleResolution": "Bundler",
    "lib": ["ES2017", "DOM"], "strict": true, "noEmit": true,
    "allowJs": true, "checkJs": false, "skipLibCheck": true,
    "rootDir": "src", "outDir": "dist"
  },
  "include": ["src/**/*.ts", "src/**/*.js"]
}
